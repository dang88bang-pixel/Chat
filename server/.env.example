# --- Required -----------------------------------------------------------
# OpenRouter key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Model --------------------------------------------------------------
# Any OpenRouter model id works; default is KAT-Coder-Air V2.5.
# CHAT_MODEL=kwaipilot/kat-coder-air-v2.5
# MAX_TOOL_STEPS=6

# --- HTTP ---------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8081

# --- Auth (recommended before exposing beyond localhost) ----------------
# When set, /api/chat requires `Authorization: Bearer <token>`.
# Mirror it in the app as EXPO_PUBLIC_API_TOKEN.
# ORCHESTRATOR_API_TOKEN=

# --- CLI tool -----------------------------------------------------------
# ENABLE_CLI_TOOL=false
# Optional allowlist of command prefixes (comma separated):
# CLI_ALLOWLIST=git ,docker ,npm run
# CLI_TIMEOUT_MS=30000

# --- External API tool --------------------------------------------------
# Set true to allow fetchExternalApi to reach localhost/private ranges.
# ALLOW_INTERNAL_NETWORKS=false
